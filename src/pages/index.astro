---
import PlotFigure from "../components/PlotFigure.astro";
import Layout from "../layouts/Layout.astro";
import * as Plot from "@observablehq/plot";
import penguins from "../assets/penguins.json";
---

<Layout>
  <main class="page home-page">
    <p>Accecsibilité</p>

    <PlotFigure
      options={{
        title: "Longueur et profondeur du culmen des manchots",
        subtitle: "Chaque point représente un manchot observé",
        caption: "Figure 1. Relation entre les deux mesures du culmen.",
        ariaLabel: "Nuage de points des mesures du culmen par espèce",
        marks: [
          Plot.dot(penguins, {
            x: "culmen_length_mm",
            y: "culmen_depth_mm",
            stroke: "species",
          }),
        ],
      }}
    />
  </main>
</Layout>
