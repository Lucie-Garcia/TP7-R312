---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "TP visualisation de données",
  description = "Visualisations accessibles avec Astro, Leaflet et Observable Plot",
} = Astro.props;

const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href="/" aria-label="Accueil — DataLab">
          <span>
            <small>TP visualisation</small>
          </span>
        </a>
        <nav class="site-nav" aria-label="Navigation principale">
          <a class:list={{ active: currentPath === "/" }} href="/">Accueil</a>
          <a
            class:list={{ active: currentPath === "/leaflet" }}
            href="/leaflet"
          >
            Établissements
          </a>
          <a
            class:list={{ active: currentPath === "/population" }}
            href="/population"
          >
            Population
          </a>
        </nav>
      </div>
    </header>
    <slot />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }

  body {
    min-height: 100vh;
  }
</style>
